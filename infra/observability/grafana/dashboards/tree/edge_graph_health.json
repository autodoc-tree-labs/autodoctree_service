{
  "uid": "autodoc-edge-graph-health",
  "title": "Edge Graph Health",
  "tags": ["autodoc", "tree", "graph"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Neighbor Edges (created / filtered)",
      "datasource": {
        "type": "prometheus",
        "uid": "autodoc-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(neighbor_edges_total_sum[5m])",
          "legendFormat": "edges_created",
          "refId": "A"
        },
        {
          "expr": "rate(edges_filtered_total_sum[5m])",
          "legendFormat": "edges_filtered",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Average Degree / Similarity",
      "datasource": {
        "type": "prometheus",
        "uid": "autodoc-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(tree_rebuild_degree_distribution_sum[5m]) / clamp_min(rate(tree_rebuild_degree_distribution_count[5m]), 0.000001)",
          "legendFormat": "avg_degree",
          "refId": "A"
        },
        {
          "expr": "rate(tree_rebuild_similarity_distribution_sum[5m]) / clamp_min(rate(tree_rebuild_similarity_distribution_count[5m]), 0.000001)",
          "legendFormat": "avg_similarity",
          "refId": "B"
        }
      ]
    }
  ]
}
